---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Heading from "../components/typography/Heading.astro";
import Text from "../components/typography/Text.astro";
import ResponsiveImage from "../components/media/ResponsiveImage.astro";
import VideoPlayer from "../components/media/VideoPlayer.astro";
interface Props {
  project: CollectionEntry<"projects">;
}
const { project } = Astro.props;
const {
  title,
  description,
  category,
  introLayout,
  placeholder,
  heroMedia,
  role,
  timeline,
  collaborators,
  tools,
  tags,
} = project.data;
const socialImage = project.data.thumbnail.src;
const heroFirst = introLayout === "hero-first";
const metadata = [
  { label: "Role", values: role },
  { label: "Timeline", values: timeline ? [timeline] : [] },
  { label: "Collaborators", values: collaborators },
  { label: "Tools", values: tools },
].filter(({ values }) => values.length > 0);
const pillGroups = [...metadata, { label: "Skills", values: tags }].filter(
  ({ values }) => values.length > 0,
);
---

<BaseLayout title={title} description={description} image={socialImage.src}>
  <div class="project-intro">
    <Section>
      {(!heroFirst || placeholder) && (
        <p class="type-label eyebrow">
          {placeholder ? "Placeholder project" : ""}
          {!heroFirst && (
            <>
              {placeholder ? " / " : ""}
              {category === "work" ? "UX & product design" : "Other project"}
            </>
          )}
        </p>
      )}
      <Heading
        as="h1"
        variant="xl"
        tone={category === "work" ? "blue" : "magenta"}
      >
        {title}
      </Heading>
      <Text size="l" tone="secondary" variant="subtitle">
        {description}
      </Text>
      {!heroFirst && metadata.length > 0 && (
        <dl>
          {metadata.map(({ label, values }) => (
            <div>
              <dt class="type-label">{label}</dt>
              <dd>{values.join(", ")}</dd>
            </div>
          ))}
        </dl>
      )}
      {!heroFirst && tags.length > 0 && (
        <p class="type-caption secondary">{tags.join(" / ")}</p>
      )}
      {heroMedia && (
        <div class="hero-media">
          {heroMedia.type === "image" ? (
            <ResponsiveImage src={heroMedia.src} alt={heroMedia.alt} priority />
          ) : (
            <VideoPlayer
              src={heroMedia.src}
              poster={heroMedia.poster}
              label={heroMedia.label}
              captions={heroMedia.captions}
              transcript={heroMedia.transcript}
            />
          )}
        </div>
      )}
      {heroFirst && pillGroups.length > 0 && (
        <dl class="project-details">
          {pillGroups.map(({ label, values }) => (
            <div>
              <dt class="type-label">{label}</dt>
              <dd>
                <ul class="pill-list" role="list">
                  {values.map((value) => (
                    <li class="metadata-pill type-caption">{value}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      )}
    </Section>
  </div>
  <div class="rule">
    <slot />
  </div>
</BaseLayout>

<style>
  dl {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
  }
  dd {
    margin: 0;
    color: var(--color-secondary);
  }
  .project-details {
    gap: var(--space-6) var(--space-12);
    margin-block-start: var(--space-6);
  }
  .project-details > div {
    min-width: 0;
  }
  .project-details dd {
    margin-block-start: var(--space-2);
  }
</style>
