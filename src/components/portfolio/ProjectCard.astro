---
import type { CollectionEntry } from "astro:content";
import ResponsiveImage from "../media/ResponsiveImage.astro";
import { sitePath } from "../../utils/routing";
interface Props {
  project: CollectionEntry<"projects">;
  layout?: "grid" | "rows";
}
const { project, layout = "grid" } = Astro.props;
const { title, description, category, thumbnail, placeholder, year, tags } =
  project.data;
---

<article
  class:list={["project-card", { "project-card--row": layout === "rows" }]}
>
  <a href={sitePath(`/projects/${project.id}/`)}>
    <ResponsiveImage src={thumbnail.src} alt={thumbnail.alt} />
    <div class="card-content">
      <p class="type-label secondary">
        {category === "work" ? "UX Design" : "Other"}
        {year && ` \u2022 ${year}`}
        {placeholder && " / Placeholder"}
      </p>
      <h3 class="type-heading-m type-project-title">{title}</h3>
      <p class="type-body-m type-subtitle secondary">{description}</p>
      {layout === "rows" && tags.length > 0 && (
        <ul class="pill-list" role="list" aria-label="Skills">
          {tags.map((tag) => (
            <li class="metadata-pill type-caption">{tag}</li>
          ))}
        </ul>
      )}
    </div>
  </a>
</article>

<style>
  a {
    display: block;
    color: var(--color-text);
    text-decoration: none;
  }
  .card-content {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6);
  }
</style>
