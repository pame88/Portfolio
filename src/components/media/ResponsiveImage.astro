---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  priority?: boolean;
  crop?: boolean;
  sizes?: string;
}
const {
  src,
  alt,
  caption,
  credit,
  priority = false,
  crop = false,
  sizes = "(max-width: 76rem) 90vw, 76rem",
} = Astro.props;
const widths = [
  ...new Set(
    [480, 800, 1200, 1600]
      .filter((width) => width < src.width)
      .concat(src.width),
  ),
];
---

<figure class:list={["media", { cropped: crop }]}>
  <Picture
    src={src}
    alt={alt}
    formats={src.format === "svg" ? ["svg"] : ["avif", "webp"]}
    widths={widths}
    sizes={sizes}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
  />
  {(caption || credit) && (
    <figcaption class="type-caption">
      {caption}
      {caption && credit && " / "}
      {credit}
    </figcaption>
  )}
</figure>

<style>
  .media {
    width: 100%;
  }
  .media :global(img) {
    width: 100%;
  }
  .cropped :global(img) {
    aspect-ratio: var(--ratio-card);
    object-fit: cover;
  }
  figcaption {
    margin-block-start: var(--space-3);
    color: var(--color-secondary);
  }
</style>
