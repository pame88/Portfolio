---
import type { ImageMetadata } from "astro";
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  priority?: boolean;
  crop?: boolean;
}
const {
  src,
  alt,
  caption,
  credit,
  priority = false,
  crop = false,
} = Astro.props;
---

<figure class:list={["media", { cropped: crop }]}>
  <img
    src={src.src}
    alt={alt}
    width={src.width}
    height={src.height}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
  />
  {(caption || credit) && (
    <figcaption class="type-caption">
      {caption}
      {caption && credit && " / "}
      {credit}
    </figcaption>
  )}
</figure>

<style>
  .media {
    width: 100%;
  }
  .media :global(img) {
    width: 100%;
  }
  .cropped :global(img) {
    aspect-ratio: var(--ratio-card);
    object-fit: cover;
  }
  figcaption {
    margin-block-start: var(--space-3);
    color: var(--color-secondary);
  }
</style>
