---
interface Props {
  as?: "h1" | "h2" | "h3" | "h4";
  variant?: "display" | "graffiti" | "xl" | "l" | "m" | "s";
  tone?: "magenta" | "blue" | "orange" | "violet";
}
const { as: Tag = "h2", variant = "l", tone } = Astro.props;
---

<Tag
  class:list={[
    variant === "display" || variant === "graffiti"
      ? `type-${variant}`
      : `type-heading-${variant}`,
    tone && `heading--${tone}`,
  ]}
>
  <slot />
</Tag>

<style>
  .heading--magenta {
    --heading-ink: var(--color-accent);
  }
  .heading--blue {
    --heading-ink: var(--color-utility-blue);
  }
  .heading--orange {
    --heading-ink: var(--color-utility-orange);
  }
  .heading--violet {
    --heading-ink: var(--color-focus);
  }
</style>
