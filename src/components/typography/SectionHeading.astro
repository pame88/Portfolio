---
import Heading from "./Heading.astro";

interface Props {
  id: string;
  title: string;
  label: string;
  as?: "h2" | "h3";
  tone?: "blue" | "pink" | "violet";
}

const { id, title, label, as = "h2", tone = "blue" } = Astro.props;
const waveBands = [
  {
    path: "M-120 94 C10 196 130 12 300 44 S510 204 690 128 S920 4 1080 66 S1280 208 1400 124",
    drift: -0.8,
    lift: 1.05,
    bend: -0.0015,
  },
  {
    path: "M-120 154 C40 20 180 190 350 144 S580 -12 760 74 S980 230 1140 132 S1320 22 1440 96",
    drift: 0.6,
    lift: 0.7,
    bend: 0.001,
  },
  {
    path: "M-120 34 C60 138 180 206 370 114 S610 18 790 158 S1050 184 1210 70 S1370 44 1450 124",
    drift: -0.35,
    lift: 0.85,
    bend: -0.0007,
  },
];
const waveOffsets = [0, 2, 5, 9, 14, 20, 27, 35, 44, 54, 65, 77];
const waveShift =
  (Array.from(id).reduce(
    (sum, character, index) => sum + character.charCodeAt(0) * (index + 1),
    0,
  ) %
    120) -
  60;
---

<header
  id={id}
  class:list={[
    "case-heading",
    "color-pair",
    `color-pair--${as === "h2" ? "sky" : "sand"}`,
    { "case-heading--chapter": as === "h2" },
  ]}
>
  {as === "h2" && (
    <svg
      class="chapter-wave"
      viewBox="0 0 1200 288"
      preserveAspectRatio="xMidYMid slice"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      aria-hidden="true"
      focusable="false"
    >
      {waveBands.map(({ path, drift, lift, bend }) => (
        <g>
          {waveOffsets.map((offset) => (
            <path
              d={path}
              transform={`translate(${waveShift + offset * drift} ${offset * lift}) scale(1 ${1 + offset * bend})`}
              vector-effect="non-scaling-stroke"
            />
          ))}
        </g>
      ))}
    </svg>
  )}
  <div class="heading-copy">
    <p class="type-label">{label}</p>
    <Heading
      as={as}
      variant={as === "h2" ? "l" : "m"}
      tone={tone === "pink" ? "magenta" : tone}
    >
      {title}
    </Heading>
  </div>
</header>

<style>
  .case-heading {
    position: relative;
    display: grid;
    padding-block-start: var(--space-8);
    border-block-start: var(--border-rule);
    scroll-margin-block-start: var(--space-8);
  }
  .case-heading--chapter {
    min-block-size: var(--height-section-wave);
    align-content: center;
    padding: var(--space-6);
    border: none;
    background-color: var(--color-page);
  }
  .chapter-wave {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0;
    width: 100%;
    height: var(--height-section-wave);
    color: var(--color-sky-light);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .heading-copy {
    position: relative;
    display: grid;
    gap: var(--space-3);
  }
  p {
    color: var(--color-secondary);
  }
</style>
