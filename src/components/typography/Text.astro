---
interface Props {
  as?: "p" | "div";
  size?: "l" | "m" | "s";
  tone?: "primary" | "secondary";
  variant?: "body" | "subtitle";
}
const {
  as: Tag = "p",
  size = "m",
  tone = "primary",
  variant = "body",
} = Astro.props;
---

<Tag
  class:list={[
    `type-body-${size}`,
    {
      secondary: tone === "secondary",
      "type-subtitle": variant === "subtitle",
    },
  ]}
>
  <slot />
</Tag>
