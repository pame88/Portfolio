---
import PageContainer from "./PageContainer.astro";
interface Props {
  width?: "content" | "full";
  id?: string;
}
const { width = "content", id } = Astro.props;
---

<section id={id} class="section">
  <slot name="heading" />
  <PageContainer width={width}>
    <div class:list={["flow", { "after-heading": Astro.slots.has("heading") }]}>
      <slot />
    </div>
  </PageContainer>
</section>

<style>
  .section {
    padding-block: var(--section-space);
  }
  .after-heading {
    padding-block-start: var(--space-6);
  }
</style>
