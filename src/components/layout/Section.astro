---
import PageContainer from "./PageContainer.astro";
interface Props {
  width?: "content" | "reading" | "wide" | "full";
  id?: string;
}
const { width = "content", id } = Astro.props;
---

<section id={id} class="section">
  <PageContainer width={width}>
    <div class="flow">
      <slot />
    </div>
  </PageContainer>
</section>

<style>
  .section {
    padding-block: var(--section-space);
  }
</style>
