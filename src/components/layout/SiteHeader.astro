---
import PageContainer from "./PageContainer.astro";
import { sitePath } from "../../utils/routing";
const links = [
  { label: "Other", href: "/creative/" },
  { label: "About", href: "/about/" },
];
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <PageContainer>
    <div class="header-content">
      <a class="brand" href={sitePath("/")} aria-label="Eamonn Burke home">
        Eamonn Burke
      </a>
      <nav aria-label="Primary">
        <ul>
          {links.map(({ label, href }) => (
            <li>
              <a
                href={sitePath(href)}
                aria-current={
                  pathname.startsWith(sitePath(href)) ? "page" : undefined
                }
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </PageContainer>
</header>

<style>
  .site-header[data-tide-active] {
    position: relative;
    z-index: calc(var(--layer-overlay) + 1);
  }
  .site-header[data-tide-active] a {
    transition: none;
  }
  .site-header a[data-tide-washed] {
    color: var(--color-on-tide);
  }
  .header-content {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }
  .brand {
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--type-heading-s);
    font-weight: var(--weight-regular);
  }
  .brand:hover,
  .brand:focus-visible {
    color: var(--color-text-complement);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    padding: var(--space-2) var(--space-1);
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: var(--type-nav);
    font-weight: var(--weight-regular);
    line-height: var(--leading-body);
    text-decoration: none;
  }
  nav a[aria-current="page"] {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-underline-offset: var(--space-2);
  }
  nav a:hover,
  nav a:focus-visible {
    color: var(--color-accent-complement);
    text-decoration: none;
  }
</style>
