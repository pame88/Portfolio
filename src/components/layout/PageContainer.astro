---
interface Props {
  width?: "content" | "reading" | "wide" | "full";
}
const { width = "content" } = Astro.props;
---

<div class:list={["container", `container--${width}`]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: calc(var(--width-content) + var(--gutter-page) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter-page);
  }
  .container--reading {
    max-width: calc(var(--width-reading) + var(--gutter-page) * 2);
  }
  .container--wide {
    max-width: calc(var(--width-wide) + var(--gutter-page) * 2);
  }
  .container--full {
    max-width: none;
    padding-inline: 0;
  }
</style>
