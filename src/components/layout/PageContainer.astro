---
interface Props {
  width?: "content" | "full";
}
const { width = "content" } = Astro.props;
---

<div class:list={["container", `container--${width}`]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter-page);
  }
  .container--full {
    padding-inline: 0;
  }
</style>
