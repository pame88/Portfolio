---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/layout/Section.astro";
import Heading from "../../components/typography/Heading.astro";
import Text from "../../components/typography/Text.astro";
import ProjectGrid from "../../components/portfolio/ProjectGrid.astro";
import { publishedProjects } from "../../utils/projects";
const projects = (await publishedProjects()).filter(
  ({ data }) => data.category === "creative",
);
---

<BaseLayout
  title="Other"
  description="A space for visual experiments and other creative projects. The initial sample is placeholder content."
>
  <Section>
    <p class="type-label eyebrow">Beyond the case study</p>
    <Heading as="h1" variant="display" tone="violet">
      Other.
    </Heading>
    <Text size="l" tone="secondary" variant="subtitle">
      Space for photography, illustration, motion, and experiments as they are
      added.
    </Text>
  </Section>
  <Section>
    <Heading as="h2" variant="m">
      Project collection
    </Heading>
    <ProjectGrid projects={projects} />
  </Section>
</BaseLayout>
