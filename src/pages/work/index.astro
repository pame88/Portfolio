---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/layout/Section.astro";
import Heading from "../../components/typography/Heading.astro";
import Text from "../../components/typography/Text.astro";
import ProjectGrid from "../../components/portfolio/ProjectGrid.astro";
import { publishedProjects } from "../../utils/projects";
const projects = (await publishedProjects()).filter(
  ({ data }) => data.category === "work",
);
---

<BaseLayout
  title="Work"
  description="UX and product design project collection. The initial sample is placeholder content."
>
  <Section>
    <p class="type-label eyebrow">UX / Product design</p>
    <Heading as="h1" variant="display">
      Work.
    </Heading>
    <Text size="l" tone="secondary">
      A home for case studies. Real project narratives and outcomes are still to
      come.
    </Text>
  </Section>
  <Section>
    <Heading as="h2" variant="m">
      Project collection
    </Heading>
    <ProjectGrid projects={projects} />
  </Section>
</BaseLayout>
