---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/layout/Section.astro";
import Heading from "../../components/typography/Heading.astro";
import Text from "../../components/typography/Text.astro";
---

<BaseLayout
  title="About"
  description="About this evolving portfolio foundation. Biography and contact information have not yet been supplied."
>
  <Section width="reading">
    <p class="type-label eyebrow">About / Placeholder</p>
    <Heading as="h1" variant="display">
      Room for a<br />
      personal story.
    </Heading>
    <Text size="l">
      This page is reserved for an author-written introduction, background,
      interests, and approach to design.
    </Text>
    <Heading as="h2" variant="m">
      Contact
    </Heading>
    <Text tone="secondary">
      Contact information will be added when supplied. No personal details or
      accomplishments have been invented.
    </Text>
  </Section>
</BaseLayout>
