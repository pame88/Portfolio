---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Heading from "../components/typography/Heading.astro";
import Text from "../components/typography/Text.astro";
import ProjectGrid from "../components/portfolio/ProjectGrid.astro";
import { publishedProjects } from "../utils/projects";
import { sitePath } from "../utils/routing";
const featured = (await publishedProjects()).filter(
  ({ data }) => data.featured,
);
---

<BaseLayout
  title="Design & creative work"
  description="A portfolio of UX, product design, and creative projects. Demonstration content is clearly labeled."
>
  <Section>
    <p class="type-label eyebrow">Design &amp; creative work</p>
    <Heading as="h1" variant="display">
      Hey, welcome in.
    </Heading>
  </Section>
  <div class="rule">
    <Section id="selected-work">
      <Heading as="h2" variant="l">
        Selected work
      </Heading>
      <Text tone="secondary" variant="subtitle">
        A collection of product design and creative work. Demonstration projects
        are labeled.
      </Text>
      <ProjectGrid projects={featured} />
    </Section>
  </div>
  <div class="rule">
    <Section>
      <Heading as="h2" variant="m">
        An evolving collection.
      </Heading>
      <Text>
        UX case studies and image-first creative projects share a considered
        foundation, with space for different kinds of storytelling.
      </Text>
      <Text>
        <a href={sitePath("/about/")}>About this portfolio</a>
      </Text>
    </Section>
  </div>
</BaseLayout>
